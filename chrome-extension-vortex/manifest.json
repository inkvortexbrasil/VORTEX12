{
  "manifest_version": 3,
  "name": "VORTEX12 - Ponte do Robô Web",
  "version": "1.3.0",
  "description": "Mantém a Central, o ChatGPT, o Gemini e o Qwen em guias da mesma janela.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.qwen.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VORTEX12: conectar o Robô Web"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8787"
  }
}
